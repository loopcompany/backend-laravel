# Zarinpal Payment Gateway Configuration
# Mode: sandbox (for testing) or normal (for production)
ZARINPAL_MODE=sandbox
# Get your merchant ID from https://www.zarinpal.com/panel
ZARINPAL_MERCHANT_ID=3adad8bf-55b7-4691-aecb-63b6c10076e0
# Callback URL (automatically generated from APP_URL)
ZARINPAL_CALLBACK_URL="${APP_URL}/wallet/callback"

# Zibal Payment Gateway Configuration
ZIBAL_MERCHANT_ID=zibal
ZIBAL_SANDBOX=true
ZIBAL_CALLBACK_URL="${APP_URL}/wallet/callback"

# reCAPTCHA Configuration
NOCAPTCHA_SITEKEY=your_recaptcha_sitekey_here
